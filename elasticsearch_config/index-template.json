{
    "index_patterns": [
        "security-logs-*",
        "security-alerts-*"
    ],
    "template": {
        "settings": {
            "number_of_shards": 1,
            "number_of_replicas": 0,
            "refresh_interval": "5s",
            "index": {
                "max_result_window": 50000,
                "mapping": {
                    "total_fields": {
                        "limit": 2000
                    }
                }
            }
        },
        "mappings": {
            "properties": {
                "@timestamp": {
                    "type": "date",
                    "format": "strict_date_optional_time||epoch_millis"
                },
                "timestamp": {
                    "type": "date",
                    "format": "strict_date_optional_time||epoch_millis"
                },
                "ingestion_timestamp": {
                    "type": "date",
                    "format": "strict_date_optional_time||epoch_millis"
                },
                "ip_address": {
                    "type": "ip"
                },
                "user_id": {
                    "type": "keyword",
                    "fields": {
                        "text": {
                            "type": "text"
                        }
                    }
                },
                "event_type": {
                    "type": "keyword"
                },
                "event_category": {
                    "type": "keyword"
                },
                "port_number": {
                    "type": "integer"
                },
                "status": {
                    "type": "keyword"
                },
                "request_payload": {
                    "type": "text",
                    "fields": {
                        "keyword": {
                            "type": "keyword",
                            "ignore_above": 256
                        }
                    },
                    "analyzer": "standard"
                },
                "severity": {
                    "type": "keyword"
                },
                "threat_score": {
                    "type": "integer"
                },
                "risk_level": {
                    "type": "keyword"
                },
                "attack_type": {
                    "type": "keyword"
                },
                "geoip": {
                    "properties": {
                        "country_name": {
                            "type": "keyword"
                        },
                        "country_code2": {
                            "type": "keyword"
                        },
                        "city_name": {
                            "type": "keyword"
                        },
                        "continent_code": {
                            "type": "keyword"
                        },
                        "location": {
                            "type": "geo_point"
                        }
                    }
                },
                "tags": {
                    "type": "keyword"
                }
            }
        }
    },
    "priority": 100,
    "version": 1,
    "_meta": {
        "description": "Index template for SOC security logs with optimized field mappings"
    }
}